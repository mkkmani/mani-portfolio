NEXT_PUBLIC_APP_URL=http://localhost:3000
MONGODB_URI="mongodb://localhost:27017"

JWT_SECRET="your-secret-key"

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-to-a-strong-password"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-password"
SMTP_FROM="your-email@gmail.com"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key"

GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

OPENROUTER_API_KEY="your-openrouter-api-key"

DEFAULT_MODEL_INDEX=1
USE_CUSTOM_AI_MODEL=false
CUSTOM_AI_MODEL=google/gemma-3-27b-it:free

# ─────────────────────────────────────────────────────────────────────────────
# Upstash Redis - rate limiting + OTP/abuse throttling
# ─────────────────────────────────────────────────────────────────────────────
# Free tier is plenty (500K commands/month). Optional locally: when unset,
# rate limiting degrades to a no-op. Create a free DB at https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# SEO / Google indexing
# ─────────────────────────────────────────────────────────────────────────────
# Service-account JSON for the Google Indexing API (admin-only SEO tools).
GOOGLE_INDEXING_CREDENTIALS="your-google-indexing-credentials"

# ─────────────────────────────────────────────────────────────────────────────
# Misc / public
# ─────────────────────────────────────────────────────────────────────────────
# Public YouTube playlist id for the ambient music player (the part after
# "list=" in a playlist URL). When empty, a curated lofi playlist is used.
NEXT_PUBLIC_YT_PLAYLIST_ID=""

NEXT_PUBLIC_GITHUB_LINK="https://github.com/your-github-link"
NEXT_PUBLIC_LINKEDIN_LINK="https://linkedin.com/in/your-linkedin-link"
NEXT_PUBLIC_TWITTER_LINK="https://twitter.com/your-twitter-link"
NEXT_PUBLIC_PERSONAL_EMAIL="your-personal-email@gmail.com"

# Note: NODE_ENV, VERCEL_URL and CI are set automatically by the runtime/host -
